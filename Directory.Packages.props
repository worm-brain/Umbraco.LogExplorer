<Project>
  <!-- Central package management: every package version is declared once, here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Umbraco versions per major (ADR 0010; UmbracoMajor comes from Directory.Build.props).
    UmbracoPackageRange: what the package compiles against (the floor) and declares to NuGet.
    UmbracoDevVersion: the concrete version sample sites and tests run, pinned with VersionOverride
    where a project references a package that also carries the range.
  -->
  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoPackageRange>[17.0.0, 18.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>17.7.0</UmbracoDevVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoPackageRange>[18.0.0, 19.0.0)</UmbracoPackageRange>
    <UmbracoDevVersion>18.2.0</UmbracoDevVersion>
  </PropertyGroup>

  <ItemGroup Label="Umbraco">
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoDevVersion)" />
    <PackageVersion
      Include="Umbraco.Cms.DevelopmentMode.Backoffice"
      Version="$(UmbracoDevVersion)"
    />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Serilog">
    <!-- Versions Umbraco 17.7 depends on (Umbraco.Cms.Infrastructure nuspec), so tests write and read the same formats. -->
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- The files provider reads compact JSON with the same reader Umbraco 17 and 18 ship (4.0.0 from 17.0.0 to 18.2.0). -->
    <PackageVersion Include="Serilog.Formatting.Compact.Reader" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
