root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,js,css,html,md}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.cs]
# CSharpier owns formatting; analyzers own correctness.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[tests/**.cs]
# Test names follow MethodName_Scenario_ExpectedBehaviour (CLAUDE.md), which needs underscores.
dotnet_diagnostic.CA1707.severity = none
# xUnit discovers public test classes; sealing or making them static is noise here.
dotnet_diagnostic.CA1515.severity = none
