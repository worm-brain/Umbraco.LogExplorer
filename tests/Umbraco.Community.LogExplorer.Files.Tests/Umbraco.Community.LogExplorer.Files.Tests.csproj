<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the Umbraco files provider (BRIEF §10.1), against the byte-exact fixtures in Features/Sources/Files/Fixtures/Logs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Umbraco.Community.LogExplorer.Files.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the Umbraco version we develop against for this major (the package itself floats from the floor). -->
    <PackageReference Include="Umbraco.Cms.Web.Website" VersionOverride="$(UmbracoDevVersion)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" VersionOverride="$(UmbracoDevVersion)" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbraco.Community.LogExplorer\Umbraco.Community.LogExplorer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="Features\Sources\Files\Fixtures\Logs\**"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
