# Keep LF in the working tree for text files, so Prettier's format:check (which expects LF)
# passes on Windows checkouts too.
* text=auto eol=lf
*.png binary
*.ico binary
# Log fixtures are byte-exact: the files provider's record ids and cursors are byte offsets, and one
# fixture deliberately uses CRLF line endings.
tests/**/Fixtures/** -text
